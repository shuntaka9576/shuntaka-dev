{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "description": "shuntaka.dev Documentation",
  "keywords": [],
  "scripts": {
    "build-docs": "uv run sphinx-build source build",
    "dev": "uv run sphinx-autobuild source build --port ${DOCS_PORT:-8000}",
    "doc-gen": "TBLS_DSN=\"mysql://root@tidb.$(tailscale status --json | jq -r '.MagicDNSSuffix'):4000/blog_dev\" tbls doc -c .tbls.yaml --rm-dist",
    "clean": "rm -rf build .turbo"
  },
  "devDependencies": {}
}
