{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "description": "shuntaka.dev Documentation",
  "keywords": [],
  "scripts": {
    "build-docs": "bun run build-sphinx && bun run build-search && bun run check-search",
    "build-sphinx": "uv run sphinx-build source build",
    "build-search": "pagefind",
    "check-search": "bun scripts/check-search.ts",
    "dev": "rm -rf build/pagefind && uv run sphinx-autobuild source build --port ${DOCS_PORT:-43004}",
    "doc-gen": "TBLS_DSN=\"mysql://root@tidb.$(tailscale status --json | jq -r '.MagicDNSSuffix'):4000/blog_dev\" tbls doc -c .tbls.yaml --rm-dist",
    "clean": "rm -rf build .turbo"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
