          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cni.*|cali.*|cilium.*|docker.*|tailscale.*\", instance=~\"$node\"}[2m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
