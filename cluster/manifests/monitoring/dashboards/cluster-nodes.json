{
  "title": "Cluster Nodes",
  "uid": "cluster-nodes",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": ["cluster", "node"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "node-var"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 90,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 91,
      "title": "Nodes",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (instance, release) (node_uname_info{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "Info"
        },
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$node\"}[2m])) * 100)",
          "format": "table",
          "instant": true,
          "refId": "CPU"
        },
        {
          "expr": "max by (instance) ((1 - (node_memory_MemAvailable_bytes{instance=~\"$node\"} / node_memory_MemTotal_bytes{instance=~\"$node\"})) * 100)",
          "format": "table",
          "instant": true,
          "refId": "Mem"
        },
        {
          "expr": "max by (instance) (node_memory_MemTotal_bytes{instance=~\"$node\"} - node_memory_MemAvailable_bytes{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "MemUsed"
        },
        {
          "expr": "max by (instance) (node_memory_MemAvailable_bytes{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "MemFree"
        },
        {
          "expr": "max by (instance) (node_memory_MemTotal_bytes{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "MemTotal"
        },
        {
          "expr": "max by (instance) ((1 - (node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$node\"} / node_filesystem_size_bytes{mountpoint=\"/\", instance=~\"$node\"})) * 100)",
          "format": "table",
          "instant": true,
          "refId": "Disk"
        },
        {
          "expr": "max by (instance) (node_load1{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "Load"
        },
        {
          "expr": "max by (instance) (node_time_seconds{instance=~\"$node\"} - node_boot_time_seconds{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "Uptime"
        },
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "Temp"
        },
        {
          "expr": "max by (instance) (node_timex_sync_status{instance=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "Sync"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true,
              "Time 10": true,
              "Time 11": true,
              "Value #Info": true
            },
            "indexByName": {
              "instance": 0,
              "release": 1,
              "Value #CPU": 2,
              "Value #Mem": 3,
              "Value #MemUsed": 4,
              "Value #MemFree": 5,
              "Value #MemTotal": 6,
              "Value #Disk": 7,
              "Value #Load": 8,
              "Value #Temp": 9,
              "Value #Sync": 10,
              "Value #Uptime": 11
            },
            "renameByName": {
              "instance": "Node",
              "release": "Kernel",
              "Value #CPU": "CPU %",
              "Value #Mem": "Mem %",
              "Value #MemUsed": "Mem used",
              "Value #MemFree": "Mem free",
              "Value #MemTotal": "Mem total",
              "Value #Disk": "Disk / %",
              "Value #Load": "Load1",
              "Value #Temp": "Temp °C",
              "Value #Sync": "NTP",
              "Value #Uptime": "Uptime"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
