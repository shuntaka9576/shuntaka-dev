# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
# dev サーバーに localhost 以外のオリジンからアクセスする場合の許可リスト (カンマ区切り、ワイルドカード可)
# 未許可オリジンだと /_next/* がブロックされ hydration されず onClick 等が一切効かなくなる
# 例: Tailscale Funnel なら自マシンの ts.net ホスト名、ngrok なら *.ngrok-free.app 等
# ALLOWED_DEV_ORIGINS=xxx.xxx.ts.net,*.ngrok-free.app,*.ngrok.app,*.ngrok.dev
