                "Type": "string",
              },
              {
                "Name": "client_ip",
                "Type": "string",
              },
              {
                "Name": "method",
                "Type": "string",
              },
              {
                "Name": "url",
                "Type": "string",
              },
              {
                "Name": "http_version",
                "Type": "string",
              },
              {
                "Name": "status",
                "Type": "int",
              },
              {
                "Name": "bytes_in",
                "Type": "bigint",
              },
              {
                "Name": "bytes_out",
                "Type": "bigint",
              },
              {
                "Name": "duration_ms",
                "Type": "bigint",
              },
              {
