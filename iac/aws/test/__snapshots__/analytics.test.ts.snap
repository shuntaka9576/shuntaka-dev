              ":states:::athena:startQueryExecution.sync","Parameters":{"QueryString":"VACUUM tidb_proxy_logs.logs","QueryExecutionContext":{"Database":"tidb_proxy_logs"},"ResultConfiguration":{"OutputLocation":"s3://",
              {
