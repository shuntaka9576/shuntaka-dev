                "Type": "string",
              },
              {
                "Name": "squid_status",
                "Type": "string",
              },
              {
                "Name": "hier_status",
                "Type": "string",
              },
            ],
            "Location": {
              "Fn::Join": [
                "",
                [
                  "s3://",
                  {
                    "Ref": "LogAnalyticsLogsBucket18E6FEA3",
                  },
                  "/iceberg/logs",
