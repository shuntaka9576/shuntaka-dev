{
  "name": "shuntaka-dev",
  "version": "1.0.0",
  "packageManager": "bun@1.1.45",
  "workspaces": [
    "apps/*",
    "tools/*",
    "iac/*",
    "docs"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "spell-check": "cspell lint . --cache --gitignore",
    "build": "turbo build",
    "type-check": "bun --filter '*' type-check",
    "test": "turbo test",
    "lint:biome": "biome check . && prettier --check **/*.yaml",
    "lint": "turbo lint",
    "fix": "bun run fix:ws && bun run fix:root",
    "fix:ws": "bun --filter '*' fix",
    "fix:root": "biome check . --write && prettier --write **/*.yaml",
    "deploy": "bun --filter @shuntaka-dev/aws deploy",
    "postinstall": "lefthook install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^24.10.4",
    "cspell": "^9.4.0",
    "lefthook": "^2.0.15",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
