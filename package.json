{
  "name": "shuntaka-dev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "spell-check": "cspell lint . --cache --gitignore",
    "build": "turbo build",
    "type-check": "pnpm --recursive type-check",
    "test": "turbo test",
    "lint:biome": "biome check . && prettier --check **/*.{yml,yaml}",
    "lint": "turbo lint",
    "fix": "pnpm run /fix:.*/",
    "fix:ws": "pnpm --recursive --if-present fix",
    "fix:root": "biome check . --write && prettier --write **/*.{yml,yaml}",
    "deploy": "pnpm -F @shuntaka-dev/aws deploy",
    "postinstall": "lefthook install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "cspell": "^9.4.0",
    "lefthook": "^2.0.13",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
