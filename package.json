{
  "name": "shuntaka-dev",
  "version": "1.0.0",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "tools/*",
    "iac/*",
    "docs"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "spell-check": "cspell lint . --cache --gitignore",
    "build": "turbo build",
    "type-check": "bun --filter '*' type-check",
    "test": "turbo test",
    "lint:biome": "biome check . && prettier --check **/*.yaml",
    "lint:oxlint": "oxlint . --type-aware --type-check --deny-warnings",
    "lint": "turbo lint",
    "fix": "bun run fix:ws && bun run fix:root",
    "fix:ws": "bun --filter '*' fix",
    "fix:root": "biome check . --write && prettier --write **/*.yaml",
    "deploy": "bun --filter @shuntaka-dev/aws deploy",
    "postinstall": "lefthook install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@types/node": "^25.0.10",
    "cspell": "^9.6.0",
    "lefthook": "^2.0.15",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  }
}
