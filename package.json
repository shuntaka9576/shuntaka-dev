{
  "name": "shuntaka-dev",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "apps/*",
    "tools/*",
    "iac/*",
    "docs"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "spell-check": "cspell lint . --cache --gitignore",
    "build": "turbo build",
    "type-check": "bun --filter '*' type-check",
    "test": "turbo test",
    "lint:fmt": "oxfmt --check . && prettier --check '**/*.{json,yaml}'",
    "lint:oxlint": "oxlint . --type-aware --type-check --deny-warnings",
    "lint": "turbo lint",
    "fix": "oxfmt . && prettier --write '**/*.{json,yaml}'",
    "deploy": "bun --filter @shuntaka-dev/aws deploy",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cspell": "^9.7.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.6"
}
