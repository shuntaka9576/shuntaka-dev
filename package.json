{
  "name": "shuntaka-dev",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "apps/*",
    "tools/*",
    "iac/*",
    "docs"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "spell-check": "cspell lint . --cache --gitignore",
    "build": "turbo build",
    "type-check": "bun --filter '*' type-check",
    "test": "turbo test",
    "lint:fmt": "vp fmt --check && prettier --check '**/*.{json,yaml}'",
    "lint:vp": "vp lint . --deny-warnings",
    "lint": "turbo lint",
    "fix": "vp fmt && prettier --write '**/*.{json,yaml}'",
    "deploy": "bun --filter @shuntaka-dev/aws deploy",
    "clean": "turbo clean",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "cspell": "^10.0.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "tsx": "^4.22.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.21"
  },
  "packageManager": "bun@1.3.6"
}
