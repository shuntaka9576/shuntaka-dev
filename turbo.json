{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#lint:fmt": {
      "dependsOn": [],
      "cache": true
    },
    "//#lint:vp": {
      "dependsOn": [],
      "cache": true
    },
    "blog-api#lint": {
      "dependsOn": [],
      "inputs": ["**/*.rs", "Cargo.toml", "Cargo.lock"],
      "cache": true,
      "passThroughEnv": ["*"]
    },
    "blog-api#test": {
      "dependsOn": [],
      "inputs": ["**/*.rs", "Cargo.toml", "Cargo.lock"],
      "cache": true,
      "passThroughEnv": ["*"]
    },
    "content-html-backfill#test": {
      "dependsOn": [],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "//#spell-check": {
      "dependsOn": [],
      "cache": true
    },
    "type-check": {
      "dependsOn": [],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "//#lint:fmt",
        "//#lint:vp",
        "//#spell-check",
        "type-check",
        "blog-api#lint"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "outputs": ["**/dist/**", "**/.next/**"],
      "cache": true
    },
    "docs#build-docs": {
      "dependsOn": [],
      "inputs": ["docs/source/**", "docs/.tbls.yaml", "docs/pyproject.toml"],
      "outputs": ["docs/build/**"],
      "cache": true
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "dependsOn": ["docs#build-docs"],
      "cache": false,
      "env": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_DEFAULT_REGION",
        "AWS_SESSION_TOKEN"
      ]
    },
    "test": {
      "inputs": ["src/**"],
      "cache": true
    },
    "build-storybook": {
      "dependsOn": [],
      "inputs": ["src/**", ".storybook/**", "package.json"],
      "outputs": ["storybook-static/**"],
      "cache": true,
      "passThroughEnv": ["STORYBOOK_BASE_PATH"]
    },
    "storybook": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
